// ============================================================================
// 日志配置模板（对应顶层 "log" 字段）
//
// 拷贝到主配置时，把下面整个对象填入顶层 "log" 键即可。
// ============================================================================

{
  "log": {
    // 日志级别：trace / debug / info / warn / error
    "level": "info",
    // 输出目标："stderr" 或文件路径
    "output": "stderr",
    // 是否在日志行前缀时间戳
    "timestamp": true
  }
}
